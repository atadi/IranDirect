# IranDirect local observability stack - environment template.
#
# Copy to `.env` in this directory and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. This template contains
# placeholders only - no secrets.

# Grafana admin account. Anonymous access is disabled; these are the only
# credentials that exist on a fresh stack. The password is delivered to
# Grafana via the _FILE mechanism: GF_SECURITY_ADMIN_PASSWORD__FILE points at a
# path (default: ./secrets/grafana_admin_password.txt, git-ignored) whose
# contents are the password. This keeps the secret out of the compose
# environment and process args. Both are required - compose fails fast if
# either is unset.
GF_SECURITY_ADMIN_USER=changeme
GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password.txt

# OTLP headers/token presented by IranDirect.Service to the collector.
# The Service never stores this in appsettings: set
# Observability:Otlp:HeadersEnvironmentVariable to the NAME of the variable
# holding this value. The local stack requires no auth, so leave it empty
# unless you have enabled an authenticator on the collector.
OTLP_HEADERS=

# Optional development-only collector debug exporter.
# Leave unset/empty to disable. Set to `normal` (or `detailed`) to log a
# telemetry summary in the collector container log. Never set in production.
# OTEL_DEBUG_VERBOSITY=normal

# ---------------------------------------------------------------------------
# Alertmanager notification placeholders (Phase 33.4). LOCAL DEFAULT: empty.
# The local stack routes all alerts to a no-op receiver and delivers nothing.
# These placeholders are for FUTURE production overrides (Phase 33.5) only -
# they are never filled with real values here, and no secret is ever
# committed. To enable a real receiver, set the matching variable in `.env`
# and reference it from a route in alertmanager/alertmanager.yml.
# ---------------------------------------------------------------------------
# SMTP/email delivery:
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_FROM=
ALERTMANAGER_EMAIL_TO=
# Generic webhook (Slack/Teams/custom):
ALERTMANAGER_WEBHOOK_URL=
# PagerDuty Events API v2:
ALERTMANAGER_PAGERDUTY_ROUTING_KEY=
