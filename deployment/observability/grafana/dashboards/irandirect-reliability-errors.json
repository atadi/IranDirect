{
  "uid": "irandirect-reliability-errors",
  "title": "IranDirect / Reliability and Errors",
  "description": "Operational triage: failures, cancellations, tail latency and telemetry pipeline health. Contains no alert rules - triage only.",
  "tags": [
    "irandirect",
    "reliability",
    "triage",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "irandirect-prometheus"
        },
        "query": {
          "query": "label_values(irandirect_runtime_cycles_started_total, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(irandirect_runtime_cycles_started_total, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "icon": "external link",
      "url": "/explore?left=%7B%22datasource%22:%22irandirect-tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceqlSearch%22,%22filters%22:%5B%7B%22id%22:%22svc%22,%22tag%22:%22service.name%22,%22operator%22:%22%3D%22,%22value%22:%5B%22IranDirect.Service%22%5D,%22valueType%22:%22string%22,%22scope%22:%22resource%22%7D%5D%7D%5D%7D",
      "targetBlank": true,
      "tooltip": "Open Tempo filtered by service.name=IranDirect.Service"
    },
    {
      "title": "Alertmanager",
      "type": "link",
      "icon": "bell",
      "url": "http://localhost:9095",
      "targetBlank": true,
      "tooltip": "Open Alertmanager (local stack, no-op receiver by default)"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Failure overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cycle failure rate",
      "description": "Failed reconciliation cycles per second. Empty until a cycle fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "irandirect-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "irandirect-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(irandirect_runtime_cycles_failed_total{deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "failures/s",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
