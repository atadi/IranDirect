{
  "uid": "pathveer-service-overview",
  "title": "PathVeer / Service Overview",
  "description": "Top-level health of PathVeer.Service: cycle throughput, outcomes, latency and route-operation reliability. Provisioned from git (Phase 33.3) - edit the JSON, not the UI.",
  "tags": [
    "pathveer",
    "overview",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pathveer-prometheus"
        },
        "query": {
          "query": "label_values(pathveer_runtime_cycles_started_total, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(pathveer_runtime_cycles_started_total, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "icon": "external link",
      "url": "/explore?left=%7B%22datasource%22:%22pathveer-tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceqlSearch%22,%22filters%22:%5B%7B%22id%22:%22svc%22,%22tag%22:%22service.name%22,%22operator%22:%22%3D%22,%22value%22:%5B%22PathVeer.Service%22%5D,%22valueType%22:%22string%22,%22scope%22:%22resource%22%7D%5D%7D%5D%7D",
      "targetBlank": true,
