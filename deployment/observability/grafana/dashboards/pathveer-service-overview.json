    {
      "id": 2,
      "type": "stat",
      "title": "Telemetry last seen",
      "description": "Age of the most recent runtime-cycle sample. Rising steadily => the Service is not reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "pathveer-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pathveer-prometheus"
          },
          "editorMode": "code",
          "expr": "time() - max(timestamp(pathveer_runtime_cycles_started_total{deployment_environment_name=~\"$env\"}))",
          "legendFormat": "last seen",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
