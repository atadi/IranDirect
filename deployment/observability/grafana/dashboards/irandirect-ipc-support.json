{
  "uid": "irandirect-ipc-support",
  "title": "IranDirect / IPC and Support Export",
  "description": "Named-pipe IPC traffic and support bundle exports: throughput, outcomes, timeouts and latency. No payloads or file paths are displayed.",
  "tags": [
    "irandirect",
    "ipc",
    "support",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "irandirect-prometheus"
        },
        "query": {
          "query": "label_values(irandirect_runtime_cycles_started_total, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(irandirect_runtime_cycles_started_total, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
