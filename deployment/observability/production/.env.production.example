# PathVeer observability — PRODUCTION environment template (Phase 33.5).
#
# Copy to .env.production and fill in REAL values there. .env.production is
# git-ignored (see deployment/observability/.gitignore). NEVER commit real
# values. This file contains placeholders/examples only.

# ---- Grafana (operator entry point) ----
GF_SECURITY_ADMIN_USER=admin
# Password is delivered via a mounted secret file in production, not here:
#   GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password.txt
# Put the actual password in secrets/grafana_admin_password.txt (git-ignored).
GF_SECURITY_ADMIN_PASSWORD=

# ---- TLS material paths (files live in secrets/, git-ignored) ----
# These are the Docker secret file paths mounted into the collector/Grafana.
# They are paths, not values, so listing them here is safe.
OTEL_COLLECTOR_TLS_CERT_PATH=./secrets/collector_tls_cert.pem
OTEL_COLLECTOR_TLS_KEY_PATH=./secrets/collector_tls_key.pem
GRAFANA_TLS_CERT_PATH=./secrets/grafana_tls_cert.pem
GRAFANA_TLS_KEY_PATH=./secrets/grafana_tls_key.pem
# The bearer token value lives in secrets/otlp_bearer_token.txt (git-ignored).

# ---- Collector OTLP auth ----
# The Service supplies this as an OTLP header. It must match the token in
# OTLP_BEARER_TOKEN below. Name only — never the value — may appear in
# appsettings; the Service reads the value from an environment variable.
OTLP_BEARER_TOKEN=replace-with-a-long-random-token

# ---- Alertmanager notification (rendered into the secret config) ----
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_USERNAME=alerts@example.com
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_EMAIL_TO=oncall@example.com
ALERTMANAGER_WEBHOOK_URL=https://hooks.example.com/services/xxx/yyy
ALERTMANAGER_PAGERDUTY_ROUTING_KEY=

# ---- Host / retention tuning (optional overrides) ----
OTELCOL_LOG_LEVEL=info
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=40GB
