<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InternalsVisibleTo>PathVeer.Core.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0-preview.3.25171.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
  </ItemGroup>

  <!-- Built-in production release-metadata trust anchors. PUBLIC keys only; the
       matching private keys are machine-local protected secrets and never ship. -->
  <ItemGroup>
    <EmbeddedResource Include="Update\BuiltInReleaseTrust\pv-meta-prod-2026-01.json" LogicalName="PathVeer.Core.Update.BuiltInReleaseTrust.pv-meta-prod-2026-01.json" />
    <EmbeddedResource Include="Update\BuiltInReleaseTrust\pv-meta-dev-2026-01.json" LogicalName="PathVeer.Core.Update.BuiltInReleaseTrust.pv-meta-dev-2026-01.json" />
  </ItemGroup>

</Project>
