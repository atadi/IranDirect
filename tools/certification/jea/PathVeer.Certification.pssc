# PathVeer Certification — JEA Session Configuration (corrected, restricted)
#
# Registers the narrow certification control plane endpoint 'PathVeer.Certification'.
# The connecting user (PV-CERT\pvcert, a UAC-filtered standard token over PowerShell Direct)
# is mapped ONLY to the narrow 'PathVeerCertificationRole' role. Execution occurs as a
# per-connection virtual account (standard JEA virtual-account behavior provides the
# administrative identity required by certification) WITHOUT the filtered parent ever holding
# an elevated token and WITHOUT any stored/passed password.
#
# SECURITY POSTURE (corrected from bbcbf1d):
#   - SessionType RestrictedRemoteServer (no FullLanguage; the restricted default applies).
#   - RunAsVirtualAccount = $true; no RunAsVirtualAccountGroups (standard virtual-account
#     identity is sufficient; adding BUILTIN\Administrators is unnecessary and broader).
#   - RoleDefinitions authorizes ONLY PV-CERT\pvcert, NOT every local administrator.
#   - No generic shell / arbitrary execution exposed. The role exposes only trusted module
#     functions with validated parameters.
#
# This replaces the rejected Scheduled-Task (RunLevel Highest) bootstrap, which real-VM
# Windows denied with "Access is denied" from the filtered PowerShell Direct parent.

@{
    SchemaVersion        = '2.0.0.0'
    GUID                 = 'f4d2c0a1-7b3e-4c9a-9f12-3e5a7b8c9d01'
    SessionType          = 'RestrictedRemoteServer'

    # Per-connection virtual account (standard JEA behavior provides the admin identity).
    RunAsVirtualAccount       = $true
    RunAsVirtualAccountGroups = @()

    # Only the certification operator identity may use the endpoint. NOT every local admin.
    RoleDefinitions = @{
        'PV-CERT\pvcert' = @{ RoleCapabilities = @('PathVeerCertificationRole') }
    }

    # Audit transcripts land in a protected, non-guest-writable location.
    TranscriptDirectory = 'C:\ProgramData\PathVeerCertificationJea\Transcripts'
}
