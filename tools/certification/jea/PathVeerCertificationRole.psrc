# PathVeer Certification — JEA Role Capability (narrow, certification-only, trusted-module surface)
#
# SECURITY POSTURE (corrected from the rejected bbcbf1d design):
#   - NO generic shell / arbitrary-execution primitive is exposed. powershell.exe, cmd.exe,
#     wscript/cscript, Start-Process, Invoke-Expression, Invoke-Command, New-ScheduledTask are
#     NOT visible. The only privileged behavior is the trusted module functions below.
#   - NO generic filesystem/registry write primitives (no Set-Content/Set-Item/New-Item visible
#     to the caller). The module performs narrowly scoped file operations against KNOWN
#     PathVeer targets only.
#   - VisibleFunctions are the certified wrappers; their caller-facing parameters are validated
#     (ValidateSet / ValidatePattern) inside the module. The module is trusted code, not caller
#     input, so it may use privileged PowerShell internally against fixed targets.
#   - VisibleCmdlets is intentionally empty: the caller issues no raw cmdlets.
#   - VisibleExternalCommands is intentionally empty: no executable is exposed to the caller.
#     (The module internally reuses the already-running PowerShell host process; that path is
#     fixed and not a caller-facing surface.)
#
# This is NOT an unrestricted Administrator PowerShell endpoint.

@{
    VisibleCmdlets        = @()
    VisibleFunctions      = @(
        'Test-PathVeerCertificationAdmin',
        'Get-PathVeerServiceState',
        'Start-PathVeerService',
        'Stop-PathVeerService',
        'Stop-PathVeerTray',
        'Get-PathVeerInstallManifest',
        'Get-PathVeerInstalledFiles',
        'Get-PathVeerRouteState',
        'Invoke-PathVeerCertificationInstall',
        'Invoke-PathVeerCli',
        'Get-PathVeerProgramDataState'
    )
    VisibleExternalCommands = @()
    VisibleAliases         = @()
    VisibleProviders        = @()

    # The trusted module supplies the implementation. Functions are validated internally.
    ModulesToImport = @('PathVeerCertificationJea')
    ScriptsToProcess = @()

    # Audit transcripts in a PROTECTED location (not C:\pv-cert). The bootstrap creates it
    # with ACLs so ordinary/filtered pvcert cannot modify or delete them.
    TranscriptDirectory = 'C:\ProgramData\PathVeerCertificationJea\Transcripts'
}
