<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Phase 37.1 — PathVeerSetup bootstrapper.

      Self-contained single-file so a normal user receives a double-clickable
      PathVeerSetup.exe with no .NET runtime prerequisite. This is the only
      production packaging decision in 37.1; all actual install/upgrade/
      migration/state logic remains in the PowerShell deployment contract
      (Install-PathVeer.ps1) and PathVeer.Core.Installation.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the PowerShell deployment script as a resource. -->
    <EmbeddedResource Include="Resources\Install-PathVeer.ps1">
      <LogicalName>PathVeer.Setup.Resources.Install-PathVeer.ps1</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
