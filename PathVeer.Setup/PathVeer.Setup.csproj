<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      Phase 37.2 — PathVeerSetup consumer installer UI.

      WinForms is the smallest appropriate Windows UI toolkit for this
      self-contained bootstrapper: it ships inside the .NET Windows Desktop
      pack already present in the SDK, adds no external workload, behaves
      correctly under High-DPI/accessibility, and keeps the bundle truly
      single-file. The UI never implements install/migration/state logic;
      it only collects intent, invokes the authoritative embedded
      Install-PathVeer.ps1, and renders its structured progress/result.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the PowerShell deployment script as a resource. -->
    <EmbeddedResource Include="Resources\Install-PathVeer.ps1">
      <LogicalName>PathVeer.Setup.Resources.Install-PathVeer.ps1</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\PathVeer.Core\PathVeer.Core.csproj" />
  </ItemGroup>

</Project>
