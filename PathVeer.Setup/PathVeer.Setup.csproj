<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      Phase 37.2 — PathVeerSetup consumer installer UI.

      WinForms is the smallest appropriate Windows UI toolkit for this
      self-contained bootstrapper: it ships inside the .NET Windows Desktop
      pack already present in the SDK, adds no external workload, behaves
      correctly under High-DPI/accessibility, and keeps the bundle truly
      single-file. The UI never implements install/migration/state logic;
      it only collects intent, invokes the authoritative embedded
      Install-PathVeer.ps1, and renders its structured progress/result.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Reuse the canonical PathVeer product icon (the only product icon in the
         repo) for the Setup EXE and its Explorer/title-bar representation. We do
         not invent a second visual identity. -->
    <ApplicationIcon>..\PathVeer.Tray\tray-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the PowerShell deployment script as a resource. -->
    <EmbeddedResource Include="Resources\Install-PathVeer.ps1">
      <LogicalName>PathVeer.Setup.Resources.Install-PathVeer.ps1</LogicalName>
    </EmbeddedResource>
    <!-- Product icon: embed so the single-file Setup EXE shows the PathVeer
         brand in its title bar and (via ApplicationIcon) in Explorer. -->
    <EmbeddedResource Include="..\PathVeer.Tray\tray-icon.ico">
      <LogicalName>PathVeer.Setup.Resources.tray-icon.ico</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\PathVeer.Core\PathVeer.Core.csproj" />
  </ItemGroup>

</Project>
